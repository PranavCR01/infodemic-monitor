# =============================================================================
#  WHO Infodemic Monitor — Frontend environment variables
#  Copy this file to frontend/.env.local and fill in every value.
#  Never commit frontend/.env.local — it is listed in .gitignore.
# =============================================================================

# Supabase project URL — Supabase Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co

# Supabase anon/public key — Supabase Dashboard → Settings → API → anon key
# This key is safe to expose in the browser; it has row-level security applied.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Railway API service URL — Railway Dashboard → api service → Settings → Domains
# For local development use: http://localhost:8000
NEXT_PUBLIC_API_URL=YOUR_RAILWAY_API_URL

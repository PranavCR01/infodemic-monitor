# =============================================================================
#  WHO Infodemic Monitor — Backend environment variables
#  Copy this file to backend/.env and fill in every value.
#  Never commit backend/.env — it is listed in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Supabase PostgreSQL)
# Where to find: Supabase Dashboard → Settings → Database
#   Pooler URL  (Transaction mode, port 6543) → use for DATABASE_URL
#   Direct URL  (port 5432)                   → use for DATABASE_URL_SYNC
#
# URL format:
#   postgresql+asyncpg://<db-user>:<password>@<pooler-host>:6543/postgres
#   The db-user is typically: postgres.<project-ref>
#   Encode special characters in the password: @ → %40
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://YOUR_SUPABASE_DB_USER:YOUR_SUPABASE_DB_PASSWORD@YOUR_SUPABASE_POOLER_HOST:6543/postgres
DATABASE_URL_SYNC=postgresql://YOUR_SUPABASE_DB_USER:YOUR_SUPABASE_DB_PASSWORD@YOUR_SUPABASE_DIRECT_HOST:5432/postgres

# -----------------------------------------------------------------------------
# REDIS (Upstash)
# Where to find: Upstash Console → your database → "rediss://" connection string
# Must use rediss:// (TLS) — plain redis:// will be rejected by Upstash.
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:YOUR_UPSTASH_REDIS_TOKEN@YOUR_UPSTASH_REDIS_HOST:6379

# -----------------------------------------------------------------------------
# SUPABASE
# Where to find: Supabase Dashboard → Settings → API
#   SUPABASE_URL        → Project URL
#   SUPABASE_SERVICE_KEY → service_role key  (secret — never expose client-side)
#   SUPABASE_JWT_SECRET  → JWT Secret
#   NEXT_PUBLIC_SUPABASE_ANON_KEY → anon / public key (used only in frontend)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=videos
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# -----------------------------------------------------------------------------
# INFERENCE PROVIDER
# Set INFERENCE_PROVIDER to either "openai" or "anthropic".
# Only the matching API key is required; the other can be left blank.
# Where to find keys:
#   OpenAI    → platform.openai.com → API keys
#   Anthropic → console.anthropic.com → API keys
# -----------------------------------------------------------------------------
INFERENCE_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# -----------------------------------------------------------------------------
# WHISPER (transcription)
# WHISPER_PROVIDER=faster_whisper  → runs locally on CPU (good for dev)
# WHISPER_PROVIDER=openai          → calls OpenAI Whisper-1 API (recommended for Railway)
# WHISPER_MODEL_SIZE only applies when using faster_whisper.
# Options: tiny | base | small | medium | large-v3
# -----------------------------------------------------------------------------
WHISPER_PROVIDER=faster_whisper
WHISPER_MODEL_SIZE=base

# -----------------------------------------------------------------------------
# STORAGE BACKEND
# STORAGE_BACKEND=supabase  → uploads videos to Supabase Storage (production)
# STORAGE_BACKEND=local     → saves to LOCAL_STORAGE_ROOT (local dev only)
# -----------------------------------------------------------------------------
STORAGE_BACKEND=supabase

# -----------------------------------------------------------------------------
# CELERY WORKER
# CELERY_CONCURRENCY=1  → local dev / GPU mode
# CELERY_CONCURRENCY=4  → recommended for Railway cloud API mode
# -----------------------------------------------------------------------------
CELERY_CONCURRENCY=1

# -----------------------------------------------------------------------------
# PIPELINE LIMITS
# These rarely need changing; leave at defaults unless you hit rate limits.
# -----------------------------------------------------------------------------
MAX_INPUT_CHARS=128000
PUBMED_RESULTS_PER_CLAIM=2

# -----------------------------------------------------------------------------
# MIGRATIONS
# RUN_MIGRATIONS=true   → API service: runs alembic upgrade head on startup
# RUN_MIGRATIONS=false  → Worker service: must NOT run migrations
# -----------------------------------------------------------------------------
RUN_MIGRATIONS=true

# -----------------------------------------------------------------------------
# AUTH & CORS
# REQUIRE_AUTH=false  → local dev (skips JWT verification)
# REQUIRE_AUTH=true   → production (all routes require Bearer token)
# ALLOWED_ORIGINS     → comma-separated list of allowed CORS origins
#                       Set to your Vercel frontend URL in production.
# -----------------------------------------------------------------------------
REQUIRE_AUTH=false
ALLOWED_ORIGINS=http://localhost:3000

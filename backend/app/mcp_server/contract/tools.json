    "search_pubmed": {
      "input_schema": {
        "$defs": {
          "PubMedFilters": {
            "additionalProperties": false,
            "description": "Optional ESearch filters. ``publication_types`` restricts the search to those\nPubMed publication types ([pt]); ``min_year``/``max_year`` filter on publication\ndate. Retractions and errata are always dropped from fetched records.",
            "properties": {
              "max_year": {
                "anyOf": [
                  {
                    "maximum": 2100,
                    "minimum": 1800,
                    "type": "integer"
                  },
                  {
                    "type": "null"

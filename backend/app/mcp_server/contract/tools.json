                "maxItems": 10,
                "title": "Publication Types",
                "type": "array"
              }
            },
            "title": "PubMedFilters",
            "type": "object"
          }
        },
        "properties": {
          "filters": {
            "anyOf": [
              {
                "$ref": "#/$defs/PubMedFilters"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "max_results": {
            "default": 20,
            "maximum": 100,

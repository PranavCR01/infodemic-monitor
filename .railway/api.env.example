DATABASE_URL=postgresql+asyncpg://...pooler...:6543/postgres
DATABASE_URL_SYNC=postgresql://...direct...:5432/postgres
REDIS_URL=rediss://...upstash.io:6379
STORAGE_BACKEND=supabase
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=...
SUPABASE_STORAGE_BUCKET=videos
# Tokens are verified against SUPABASE_URL/auth/v1/.well-known/jwks.json (ES256/RS256),
# so SUPABASE_URL is required. SUPABASE_JWT_SECRET is only the legacy HS256 fallback:
# optional; leave empty once the legacy secret is revoked.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_CACHE_SECONDS=600
SUPABASE_JWKS_MIN_REFETCH_SECONDS=30
INFERENCE_PROVIDER=openai
WHISPER_PROVIDER=openai
WHISPER_MODEL_SIZE=base
OPENAI_API_KEY=...
ANTHROPIC_API_KEY=...
REQUIRE_AUTH=true
ALLOWED_ORIGINS=https://your-app.vercel.app
RUN_MIGRATIONS=true
CELERY_CONCURRENCY=4
MAX_INPUT_CHARS=128000
PUBMED_RESULTS_PER_CLAIM=2

   {
    "id": "t1",
    "start": 0.0,
    "end": 1.48,
    "text": "Espera, espera, espera, espera, espera."
   },
   {
    "id": "t2",
    "start": 1.48,
    "end": 5.24,
    "text": "Tenemos la solución perfecta para que se hagas de fiesta y no tengas resagar el día siguiente."
   },
   {
    "id": "t3",
    "start": 5.24,
    "end": 6.18,
    "text": "¡Veme, men!"
   },
   {
    "id": "t4",
    "start": 6.18,
    "end": 6.88,
    "text": "¡Escucha!"
   },
   {
    "id": "t5",
    "start": 6.88,
    "end": 7.92,
    "text": "¿No bebas alcohol?"
   },
   {
    "id": "t6",
    "start": 7.92,
    "end": 12.24,
    "text": "¿Es eso cierto de que cuanto más alcohol se tome, peor cuerpo se tendrá el día siguiente?"
   },
   {
    "id": "t7",
    "start": 12.24,
    "end": 13.12,
    "text": "¡Apirmativo!"
   },
   {
    "id": "t8",
    "start": 13.12,
    "end": 15.12,
    "text": "Entonces, ¿cómo intento evitarla?"
   },
   {
    "id": "t9",
    "start": 15.12,
    "end": 16.8,
    "text": "Pues, no, bebiendo."
   },
   {
    "id": "t10",
    "start": 16.8,
    "end": 20.8,
    "text": "Por lo menos, si decides no hacernos caso, que no es lo más correcto,"
   },
   {
    "id": "t11",
    "start": 20.8,
    "end": 26.0,
    "text": "intenta hacerlo con el estómago lleno, alternar vasos de agua antes, durante y después de las copas,"
   },
   {
    "id": "t12",
    "start": 26.0,
    "end": 28.0,
    "text": "y no alternar, no con el sumeteo."
   },
   {
    "id": "t13",
    "start": 28.0,
    "end": 30.76,
    "text": "Pero ir de cañas al día siguiente ni mirar pH, ¿verdad?"
   },
   {
    "id": "t14",
    "start": 30.76,
    "end": 31.76,
    "text": "NOOOOOO"
   },
   {
    "id": "t15",
    "start": 31.76,
    "end": 33.76,
    "text": "¿Te va a aprecier comida grasiente al día siguiente?"
   },
   {
    "id": "t16",
    "start": 33.76,
    "end": 34.76,
    "text": "Si"
   },
   {
    "id": "t17",
    "start": 34.76,
    "end": 35.76,
    "text": "¿Que te vas a sentar bien?"
   },
   {
    "id": "t18",
    "start": 35.76,
    "end": 36.76,
    "text": "¡Que nooo!"
   },
   {
    "id": "t19",
    "start": 36.76,
    "end": 37.76,
    "text": "El café sí, ya que sí"
   },
   {
    "id": "t20",
    "start": 37.76,
    "end": 39.26,
    "text": "TAMPOCO!"
   },
   {
    "id": "t21",
    "start": 39.26,
    "end": 41.26,
    "text": "Ante la duda mejor y bufrofeno que para que está mole"
   }

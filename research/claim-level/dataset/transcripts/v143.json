  "segments": [
   {
    "id": "t1",
    "start": 0.0,
    "end": 3.5,
    "text": "A 15 ans, il vient d'inventer un savon qui traite le cancer de la peau."
   },
   {
    "id": "t2",
    "start": 3.5,
    "end": 7.66,
    "text": "L'américain Eman Beakhill, 15 ans, a déjà remporté de nombreux prix scientifiques."
   },
   {
    "id": "t3",
    "start": 7.66,
    "end": 9.3,
    "text": "Mais là, c'est très fort."
   },
   {
    "id": "t4",
    "start": 9.3,
    "end": 13.02,
    "text": "Il a conçu un savon qui protège du cancer de la peau, avec de nombreuses propriétés"
   },
   {
    "id": "t5",
    "start": 13.02,
    "end": 14.78,
    "text": "qui persistent même après rinçage."
   },
   {
    "id": "t6",
    "start": 14.78,
    "end": 18.78,
    "text": "Le coût est d'ailleurs estimé à 50 centimes, une au ben dans un pays où la médecine coûte cher"
   },
   {
    "id": "t7",
    "start": 18.78,
    "end": 19.78,
    "text": "comme aux États-Unis."
   },
   {
    "id": "t8",
    "start": 19.78,
    "end": 23.6,
    "text": "Avec un peu de patience, le produit pourrait être commercialisé dans les prochaines années."
   },
   {
    "id": "t9",
    "start": 23.6,
    "end": 26.98,
    "text": "Eman, lui, est déjà vu comme l'enfant de l'année 2024 par le Times."
   }
  ]
 },

  "duration_seconds": 55.61,
  "segments": [
   {
    "id": "t1",
    "start": 0.0,
    "end": 3.1,
    "text": "¿Existe el calle solar?"
   },
   {
    "id": "t2",
    "start": 3.1,
    "end": 7.38,
    "text": "Podríamos decir que el calle solar existe, pero eso no quiere decir que el calle solar"
   },
   {
    "id": "t3",
    "start": 7.38,
    "end": 8.38,
    "text": "sea bueno."
   },
   {
    "id": "t4",
    "start": 8.38,
    "end": 12.14,
    "text": "Quien habla del calle solar dice que la piel se tiene que ir exponiendo sin protección"
   },
   {
    "id": "t5",
    "start": 12.14,
    "end": 15.14,
    "text": "solar al sol, ya que progresivamente se va curtiendo."
   },
   {
    "id": "t6",
    "start": 15.14,
    "end": 19.66,
    "text": "Eso es verdad, porque la piel, a medida que ya va cogiendo color la melanina se estimula"
   },
   {
    "id": "t7",
    "start": 19.66,
    "end": 24.18,
    "text": "y deja de quemarse en algún momento, pero sigue recibiendo el daño crónico del sol."
   },
   {
    "id": "t8",
    "start": 24.18,
    "end": 28.38,
    "text": "Y vemos el calle solar, no solo por el aumento de riesgo del cáncer de piel, sino que también"
   },
   {
    "id": "t9",
    "start": 28.38,
    "end": 33.18,
    "text": "lo vemos por los signos que se manifiestan de envejecimiento prematuro en nuestra cara."
   },
   {
    "id": "t10",
    "start": 33.18,
    "end": 38.58,
    "text": "Así que, si quieres tener callo solar, pues sí, tendrás más arrugas, más flacidez,"
   },
   {
    "id": "t11",
    "start": 38.58,
    "end": 42.5,
    "text": "porque perderás colágeno, más manchas, un aspecto más envejecido, pero la piel estará"
   },
   {
    "id": "t12",
    "start": 42.5,
    "end": 47.74,
    "text": "curtida, estará curtida. Así que, tú decides si quieres callo solar o prefieres protección"
   },
   {
    "id": "t13",
    "start": 47.74,
    "end": 51.82,
    "text": "solar y tener una cara más joven y más sana para el resto de la vida."
   }
  ]
 },

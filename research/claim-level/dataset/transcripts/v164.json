 "transcript": {
  "language": "fr",
  "language_probability": 0.997,
  "duration_seconds": 64.44,
  "segments": [
   {
    "id": "t1",
    "start": 0.0,
    "end": 3.28,
    "text": "Que se passe-t-il si tu ne manges que de la viande pendant une semaine ?"
   },
   {
    "id": "t2",
    "start": 3.28,
    "end": 5.88,
    "text": "Le premier jour, tu te sentiras en pleine forme."
   },
   {
    "id": "t3",
    "start": 5.88,
    "end": 10.44,
    "text": "Ton corps reçoit une grande dose de protéines et ton énergie grimpe en flèches."
   },
   {
    "id": "t4",
    "start": 10.44,
    "end": 16.12,
    "text": "Le deuxième jour, ton corps commencera à réclamer du sucre et des glucides, mais croit-moi, ça en vaut la peine."
   },
   {
    "id": "t5",
    "start": 16.12,
    "end": 18.4,
    "text": "Au troisième jour, tu entres en ces thoses."
   },
   {
    "id": "t6",
    "start": 18.4,
    "end": 22.84,
    "text": "Ton corps commence à brûler les graisses pour produire de l'énergie au lieu du sucre."
   },
   {
    "id": "t7",
    "start": 22.84,
    "end": 26.0,
    "text": "Résultat, la perte de poids devient plus facile."
   },
   {
    "id": "t8",
    "start": 26.0,
    "end": 29.08,
    "text": "Le quatrième jour, l'inflammation dans ton corps diminue."
   },
   {
    "id": "t9",
    "start": 29.08,
    "end": 33.62,
    "text": "Tu te sens plus énergique, plus concentré, et même les douleurs dans les articulations"
   },
   {
    "id": "t10",
    "start": 33.62,
    "end": 35.14,
    "text": "commencent à disparaître."
   },
   {
    "id": "t11",
    "start": 35.14,
    "end": 41.7,
    "text": "Le 5ème jour, ton organisme s'adapte complètement et tire enfin profit des nutriments biodisponibles"
   },
   {
    "id": "t12",
    "start": 41.7,
    "end": 42.7,
    "text": "de la viande."
   },
   {
    "id": "t13",
    "start": 42.7,
    "end": 45.42,
    "text": "En clair, ton corps utilise vraiment ce que tu manges."
   },
   {
    "id": "t14",
    "start": 45.42,
    "end": 49.74,
    "text": "Le 6ème jour, tu ressens tout le potentiel de ton corps et tu regrettes de ne pas avoir"
   },
   {
    "id": "t15",
    "start": 49.74,
    "end": 50.74,
    "text": "commencé plus tôt."
   },
   {
    "id": "t16",
    "start": 50.74,
    "end": 55.74,
    "text": "Le 7ème jour, ton inflammation a diminué, ton énergie et ta concentration ont augmenté"
   },
   {
    "id": "t17",
    "start": 55.74,
    "end": 57.18,
    "text": "et ton corps est plus fort."
   },
   {
    "id": "t18",
    "start": 57.18,
    "end": 61.88,
    "text": "plus affûté, prêt pour une deuxième semaine, et celui à qui tu en verras cette vidéo"
   },
   {
    "id": "t19",
    "start": 61.88,
    "end": 64.28,
    "text": "te devra indiner avec un bon steak."
   }
  ]
 },
